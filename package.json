{
  "name": "markets-terminal",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx watch --env-file=.env server/index.ts\" \"vite\"",
    "build": "vite build && tsc -p tsconfig.node.json",
    "start": "node dist/server/index.js",
    "deploy": "npm run build && npx gh-pages -d dist/client"
  },
  "dependencies": {
    "@google/genai": "^2.8.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tanstack/react-query": "^5.75.0",
    "express": "^5.1.0",
    "framer-motion": "^12.42.0",
    "pg": "^8.13.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^6.28.0",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/express": "^5.0.3",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.4"
  }
}
